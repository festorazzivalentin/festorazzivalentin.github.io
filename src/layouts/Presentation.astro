<style>
section {
    margin: 400px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    .title {
        position: relative;
        bottom: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    h1 {
        font-family: 'Playfair Italic';
        font-weight: 900;
        font-size: 6rem;
        letter-spacing: -0.01em;

        color: transparent;
        background: linear-gradient(
            100deg, 
            var(--primary-color) 15%,
            var(--terciary-color) 45%,
            var(--secondary-color) 85%
            );
        background-clip: text;
    }

    p {
        color: var(--neutral-grey);
        letter-spacing: 0.04rem;
    }

    svg {
        position: absolute;
    }
}
</style>

<section>
    <svg viewBox="0 0 900 460" preserveAspectRatio="xMidYMid slice">
        <path d="M-40,420 Q380,40 920,180" fill="none" stroke="var(--primary-color)" stroke-width="1.6" opacity="0.16"/>
        <g stroke="var(--primary-color)" stroke-width="1.6" opacity="0.16" stroke-linecap="round">
        <line x1="895" y1="170" x2="920" y2="180"/>
        <line x1="900" y1="196" x2="920" y2="180"/>
        </g>
        <path d="M940,410 Q560,90 -20,240" fill="none" stroke="var(--secondary-color)" stroke-width="1.6" opacity="0.22"/>
        <g stroke="var(--secondary-color)" stroke-width="1.6" opacity="0.22" stroke-linecap="round">
        <line x1="3" y1="228" x2="-20" y2="240"/>
        <line x1="6" y1="254" x2="-20" y2="240"/>
