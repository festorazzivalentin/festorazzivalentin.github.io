---
import About from '@/components/About.astro';
import CategoryShowcase from '@/components/CategoryShowcase.astro';
import Contact from '@/components/Contact.astro';
import Hero from '@/components/Hero.astro';
import MissionVision from '@/components/MissionVision.astro';
import Services from '@/components/Services.astro';
import Verifications from '@/components/Verifications.astro';
import Wholesale from '@/components/Wholesale.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dictionaries, type Locale } from '@/i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale];
---

<BaseLayout locale={locale}>
    <Hero t={t} />
    <MissionVision t={t} />
    <Services t={t} />
    <!-- <CategoryShowcase t={t} /> -->
    <About t={t} />
    <!-- <Verifications t={t} /> -->
    <Wholesale t={t} />
    <Contact t={t} />
</BaseLayout>
