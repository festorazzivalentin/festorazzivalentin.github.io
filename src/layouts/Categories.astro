---
import Category from "@/components/Category.astro";
---

<style>
    .categories-section {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        hgroup {
            text-align: center;
            margin-bottom: 2rem;
        }

        .categories {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 3rem;
        }
    }
</style>

<section class="categories-section">
    <hgroup>
        <h1>Categorías de interés</h1>
        <p>Estamos interesados en hacer negociaciones con los siguientes productos</p>
    </hgroup>
    <div class="categories">
        <Category/>
        <Category/>
        <Category/>
        <Category/>
        <Category/>
        <Category/>
        <Category/>
        <Category/>
    </div>

</section>