---
import Verification from "@/components/Verification.astro";
import ContactBtn from "@/components/ContactBtn.astro";
---

<style>
    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4rem;
        
        .verification-header {
            padding-top: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.4rem;
            place-items: center;
        }

        h1 {
            font-weight: 900;
        }
    }
    
</style>

<section>
    <header class="verification-header">
        <hgroup>
            <h1>Puedes confiar en nosotros</h1>
            <p>Somos una compañía registrada</p>
        </hgroup>
    </header>

    <div class="cards">
        <Verification title="Registrados legalmente" description="Estamos matriculados legalmente en el Internal Revenue Service (IRS)" />
        <Verification />
        <Verification />
        <Verification />
    </div>

    <footer>
        <ContactBtn value="Descargar datos" />
    </footer>
</section>