---
import { SOCIALS } from '@/data/site';
import { withBase } from '@/i18n';

interface Props {
    /** `navy` for the dark header/footer, `light` for content sections. */
    tone?: 'navy' | 'light';
    class?: string;
}

const { tone = 'navy', class: className } = Astro.props;
---

<ul class:list={['socials', className]} data-tone={tone}>
    {
        SOCIALS.map((social) => (
            <li>
                <a
                    class="socials__link"
                    href={social.href}
                    rel="noopener noreferrer"
                    target="_blank"
                    title={social.label}
                >
                    <span class="visually-hidden">{social.label}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <use href={withBase(`assets/icons/social.svg#${social.id}`)} />
                    </svg>
                </a>
            </li>
        ))
    }
</ul>

<style>
    .socials {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .socials__link {
        --size: 2.5rem;

        display: grid;
        place-items: center;
        inline-size: var(--size);
        block-size: var(--size);
        border-radius: 50%;
        background-color: var(--on-navy-hover);
        color: var(--on-navy);
        transition:
            background-color var(--speed) var(--ease),
            color var(--speed) var(--ease),
            transform var(--speed) var(--ease);
    }

    .socials[data-tone='light'] .socials__link {
        background-color: var(--accent-soft);
        color: var(--accent-icon);
    }

    .socials__link svg {
        inline-size: 1.15rem;
        block-size: 1.15rem;
    }

    .socials__link:hover {
        transform: translateY(-2px);
        background-color: var(--gold);
        color: var(--navy-900);
    }

    .socials[data-tone='light'] .socials__link:hover {
        background-color: var(--blue);
        color: var(--on-navy);
    }

    .socials__link:active {
        transform: scale(0.94);
    }
</style>
