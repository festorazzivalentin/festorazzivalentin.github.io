---
import { withBase } from '@/i18n';

interface Props {
    label: string;
    /** Sprite reference, e.g. `beauty.svg#cosmetics` */
    sprite: string;
    variant?: string;
}

const { label, sprite, variant = 'blue' } = Astro.props;
---

<div class="card" data-variant={variant}>
    <span class="card__badge">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <use href={withBase(`assets/icons/${sprite}`)}></use>
        </svg>
    </span>
    <p class="card__label">{label}</p>
</div>

<style>
    .card {
        --tint: var(--blue);
        --tint-soft: var(--accent-soft);
        --tint-strong: var(--blue-strong);

        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.1rem;
        padding: 1.75rem 1rem 1.5rem;
        border: 1px solid var(--surface-border);
        border-radius: var(--radius-lg);
        background-color: var(--surface);
        box-shadow: var(--shadow-soft);
        text-align: center;
        transition:
            transform var(--speed) var(--ease),
            box-shadow var(--speed) var(--ease),
            border-color var(--speed) var(--ease);
    }

    .card:hover {
        transform: translateY(-3px);
        border-color: color-mix(in srgb, var(--tint) 45%, transparent);
        box-shadow: var(--shadow-lift);
    }

    .card__badge {
        display: grid;
        place-items: center;
        inline-size: clamp(4rem, 9vw, 5.5rem);
        aspect-ratio: 1;
        border-radius: 50%;
        background-color: var(--tint-soft);
        color: var(--tint);
        transition:
            background-color 0.3s var(--ease),
            color 0.3s var(--ease),
            transform 0.3s var(--ease);
    }

    .card:hover .card__badge {
        background-color: var(--tint);
        color: var(--bg);
        transform: scale(1.04);
    }

    .card__badge svg {
        inline-size: 58%;
        block-size: auto;
    }

    .card__label {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.3;
        color: var(--text-primary);
    }

    /* Pastel palette carried over from the original design */
    .card[data-variant='pink'] {
        --tint: #f0639f;
        --tint-soft: light-dark(#ffe0ec, #3a1f2c);
    }
    .card[data-variant='wallet'] {
        --tint: #7b4ddb;
        --tint-soft: light-dark(#f0e7ff, #241a3d);
    }
    .card[data-variant='education'] {
        --tint: #b07c00;
        --tint-soft: light-dark(#ffeeba, #3a2f0d);
    }
    .card[data-variant='seasonal-green'] {
        --tint: #1e9e5a;
        --tint-soft: light-dark(#d6f5e0, #10301f);
    }
    .card[data-variant='personal-care'] {
        --tint: #12857f;
        --tint-soft: light-dark(#d9fbfa, #0e3030);
    }
    .card[data-variant='books'] {
        --tint: #c2661a;
        --tint-soft: light-dark(#fce3c7, #33210f);
    }
    .card[data-variant='home-accents'] {
        --tint: #e0663c;
        --tint-soft: light-dark(#ffe0d6, #35201a);
    }
    .card[data-variant='baby-kids'] {
        --tint: #0d7fb8;
        --tint-soft: light-dark(#e3f6ff, #102a38);
    }
</style>
