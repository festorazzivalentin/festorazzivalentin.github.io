---
const title = 'Companía registrada';
const description = 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Consequuntur, non, aut ducimus molestiae amet maiores.';
---

<style>
.container {
    display: flex;
    width: max-content;
    max-width: 350px;
    align-items: center;
    flex-wrap: wrap;
    padding: 1rem;
    margin: .9rem;

    background-color: var(--light-gray-color);
    border: 1px solid var(--neutral-white);
    box-shadow: 12px 17px 51px #00000038;
    backdrop-filter: blur(6px);
    border-radius: 1rem;
    user-select: none;

    transition: all 0.5s;

    &:hover {
        border: 1px solid var(--secondary-color);

        svg { 
            transform: scale(1.6);
            rotate: -20deg;
        };
    }

    &:active {
        transform: scale(0.85) rotateZ(1.7deg);
    }

    header {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;

        svg {
            transition: all 0.5s;
            color: var(--secondary-color);
            width: 1.5rem;
            height: 1.5rem;
        }

        h2 {
            font-family: 'Inter';
            font-size: 0.9rem;
        }
    }

    p {
        margin: 0;
        color: var(--neutral-grey);
        font-family: 'Inter';
        font-size: 0.8rem;
    }
}
</style>

<div class="container">
    <header>
        <svg><use href="/assets/icons/others.svg#verification-check"></use></svg>
        <h2>{title}</h2>
    </header>
    <p>{description}</p>
</div>

<script>

</script>