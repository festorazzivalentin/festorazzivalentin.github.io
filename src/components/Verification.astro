---
const { title, description } = Astro.props;

const DEAFULT_TITLE = 'Companía registrada';
const DEFAULT_VALUE = 'Lorem, ipsum dolor sit amet consectetur';
---

<style>
.card {
    width: 280px;
    align-items: center;
    flex-wrap: wrap;
    padding: 1rem;

    border: 1px solid transparent;
    border-radius: 1rem;
    
    background-color: var(--light-gray-color);
    box-shadow: 12px 17px 51px #00000038;
    backdrop-filter: blur(6px);

    user-select: none;
    transition: all 0.5s;

    &:hover {
        border-color: var(--secondary-color);

        svg { 
            transform: scale(1.6);
            rotate: -20deg;
        };
    }

    &:active {
        transform: scale(0.85) rotateZ(1.7deg);
    }

    .description {
        pading: 0;
        display: flex;
        flex-direction: column;
        gap: .4rem;
        margin-bottom: .2rem;



        h2 {
            font-family: 'Inter';
            font-size: 0.9rem;
        }
    }

    p {
        margin: 0;
        color: var(--neutral-grey);
        font-family: 'Inter';
        font-size: 0.8rem;
    }

    .check {

        transition: all 0.5s;
        color: var(--secondary-color);
        width: 1.5rem;
        height: 1.5rem;
    }
}
</style>

<div class="card">
    <svg class="check"><use href="/assets/icons/others.svg#verification-check"></use></svg>
    <div class="description">
        <h2>{title ?? DEAFULT_TITLE}</h2>
        <p>{description ?? DEFAULT_VALUE}</p>
    </div>
</div>
