---
const { title, description } = Astro.props;

const DEAFULT_TITLE = "Companía registrada";
const DEFAULT_VALUE = "Lorem, ipsum dolor sit amet consectetur";
---

<style>
    .card {
        width: 300px;
        height: 80px;
        align-items: center;
        flex-wrap: wrap;
        padding: 1rem;

        border: 1px solid transparent;
        border-radius: 1rem;

        background-color: var(--light-gray-color);
        box-shadow: 12px 17px 51px #00000038;
        backdrop-filter: blur(6px);
        user-select: none;
        transition: all 0.5s;

        &:hover {
            border-color: var(--secondary-color);

            svg {
                transform: scale(2);
                rotate: -15deg;
            }
        }

        &:active {
            transform: scale(0.85) rotateZ(1.7deg);
        }

        .description {
            pading: 0;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-bottom: 0.2rem;

            h3 {
                font-family: "Inter";
                color: var(--secondary-color);
            }
        }

        p {
            margin: 0;
            color: var(--neutral-grey);
            font-family: "Inter";
        }

        .check {
            position: absolute;
            top: -10px;
            left: -10px;
            transition: all 0.5s;
            color: var(--secondary-color);
            width: 1.5rem;
            height: 1.5rem;
        }


    }
</style>

<div class="card">
    <svg class="check"><use href="/assets/icons/others.svg#verification-check"></use></svg>
    <div class="description">
        <h3>{title ?? DEAFULT_TITLE}</h3>
        <p>{description ?? DEFAULT_VALUE}</p>
    </div>
</div>
