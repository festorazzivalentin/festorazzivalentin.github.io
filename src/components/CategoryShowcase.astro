---
import CategoryCard from '@/components/CategoryCard.astro';
import { CATEGORIES } from '@/data/site';
import type { Dictionary } from '@/i18n';

interface Props {
    t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="categories">
    <div class="container">
        <div class="section-head">
            <h2>{t.categories.title}</h2>
            <p>{t.categories.subtitle}</p>
        </div>

        <ul class="categories">
            {
                t.categories.items.map((category, index) => {
                    const { variant, sprite } = CATEGORIES[index % CATEGORIES.length];
                    return (
                        <li>
                            <CategoryCard label={category.label} sprite={sprite} variant={variant} />
                        </li>
                    );
                })
            }
        </ul>
    </div>
</section>

<style>
    .categories {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
        gap: clamp(0.85rem, 2vw, 1.35rem);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .categories > li {
        display: grid;
    }

    .categories > li > :global(.card) {
        inline-size: 100%;
    }
</style>
