<style>
    .container {
        padding: .2rem;
        width: max-content;
        background: linear-gradient(black, lightgray);
    }

    .box {
        --size: 250px;

        width: var(--size);
        height: var(--size);
        background: linear-gradient(indigo, deeppink);
        color: white;
        font-size: 2.25rem;
        display: grid;
        place-items: center;
        font-weight: 600;
        text-align: center;
        padding: 0.8rem;
        margin: 1rem;
        font-family: 'Inter';

        transform-style: preserve-3d;
        span {
            transform: translateZ(25px);
        }
    }
</style>

<div class="container">
    <div class="box">
        <span>
            Soy una re caja bella hadid xd
        </span>
    </div>
</div>

<script>
    import Tilt from 'vanilla-tilt';

    const box = document.querySelector('.box') as HTMLElement;

    Tilt.init(box, {
        glare: true,
        perspective: 500,
        max: 35,
    })
</script>