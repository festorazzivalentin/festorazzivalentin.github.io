---
const { value, link } = Astro.props;
---

<style>
a {
    display: inline-block;

    font-family: 'Inter';
    text-decoration: none;
    color: inherit;
    background: transparent;
    border: none;
    transition:
        color 0.2s;

    cursor: pointer;

    &:hover {
        color: var(--secondary-color);
    }
}
</style>

<a href={link}>
    {value}
</a>