---
import VerificationCard from '@/components/VerificationCard.astro';
import type { Dictionary } from '@/i18n';

interface Props {
    t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section trust" aria-labelledby="trust-heading">
    <div class="container trust__inner">
        <div class="section-head trust__head">
            <h2 id="trust-heading">{t.verifications.title}</h2>
            <p>{t.verifications.subtitle}</p>
        </div>

        <ul class="trust__list">
            {
                t.verifications.items.map((item) => (
                    <li>
                        <VerificationCard title={item.title} description={item.desc} />
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .trust__inner {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
    }

    .trust__head {
        margin-block-end: 0;
    }

    .trust__list {
        display: grid;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    @media (width < 47.5rem) {
        .trust__inner {
            grid-template-columns: 1fr;
        }
    }
</style>
