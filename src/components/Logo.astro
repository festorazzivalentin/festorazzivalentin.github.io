---
import { SITE } from '@/data/site';

interface Props {
    stacked?: boolean;
    class?: string;
}

const { stacked = false, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
    <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <rect class="logo__square" x="4" y="4" width="23" height="23" rx="6"></rect>
        <rect class="logo__square logo__square--gold" x="15" y="15" width="21" height="21" rx="6"
        ></rect>
    </svg>
    <span class="logo__name">
        {stacked ? <><span>Blue &amp; Yellow</span><br /><span>Service</span></> : SITE.name}
    </span>
</span>

<style>
    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: inherit;
    }

    .logo__mark {
        inline-size: 2.125rem;
        block-size: 2.125rem;
        flex: 0 0 auto;
    }

    .logo__square {
        fill: currentColor;
    }

    .logo__square--gold {
        fill: var(--gold);
    }

    .logo__name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        line-height: 1.15;
        letter-spacing: -0.01em;
    }
</style>
