---
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { SECTIONS } from '@/data/site';
import { LOCALES, localeNames, localePath, type Dictionary, type Locale } from '@/i18n';

interface Props {
    t: Dictionary;
    locale: Locale;
}

const { t, locale } = Astro.props;
---

<header class="site-header" data-site-header>
    <div class="container site-header__inner">
        <a class="site-header__brand" href="#home">
            <Logo stacked />
        </a>

        <nav class="site-header__nav" aria-label={t.a11y.primaryNav}>
            <ul class="site-header__links">
                {
                    SECTIONS.map((section) => (
                        <li>
                            <a
                                href={`#${section.id}`}
                                data-nav-link={section.id}
                                aria-current={section.id === 'home' ? 'true' : undefined}
                            >
                                {t.nav[section.key]}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="site-header__controls">
            <div class="lang-switch" role="group" aria-label={t.a11y.language}>
                {
                    LOCALES.map((code, index) => (
                        <>
                            {index > 0 && (
                                <span class="lang-switch__divider" aria-hidden="true">
                                    /
                                </span>
                            )}
                            <a
                                class="lang-switch__link"
                                href={localePath(code)}
                                lang={code}
                                hreflang={code}
                                aria-current={code === locale ? 'true' : 'false'}
                                title={localeNames[code]}
                            >
                                {code.toUpperCase()}
                            </a>
                        </>
                    ))
                }
            </div>

            <button
                class="icon-button"
                type="button"
                data-theme-toggle
                data-label-dark={t.a11y.switchToDark}
                data-label-light={t.a11y.switchToLight}
                aria-label={t.a11y.switchToDark}
            >
                <span class="icon-button__stack">
                    <Icon class="icon-button__icon" name="sun" />
                    <Icon class="icon-button__icon" name="moon" />
                </span>
            </button>

            <button
                class="icon-button site-header__menu-button"
                type="button"
                data-menu-toggle
                aria-expanded="false"
                aria-controls="mobile-nav"
                aria-label={t.a11y.openMenu}
            >
                <span class="icon-button__stack">
                    <Icon class="icon-button__icon" name="menu" />
                    <Icon class="icon-button__icon" name="close" />
                </span>
            </button>
        </div>
    </div>

    <nav class="mobile-nav" id="mobile-nav" data-mobile-nav aria-label={t.a11y.mobileNav} hidden>
        <ul class="container mobile-nav__list">
            {
                SECTIONS.map((section) => (
                    <li>
                        <a href={`#${section.id}`} data-nav-link={section.id}>
                            {t.nav[section.key]}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<style>
    .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background-color: var(--navy-900);
        color: var(--on-navy);
    }

    .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-block: 0.85rem;
    }

    .site-header__brand {
        flex: 0 0 auto;
    }

    .site-header__links {
        display: flex;
        gap: clamp(0.75rem, 1.6vw, 1.9rem);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .site-header__links a {
        position: relative;
        display: inline-block;
        padding-block: 0.25rem;
        font-size: 0.95rem;
        white-space: nowrap;
        color: var(--on-navy-soft);
        transition: color var(--speed) var(--ease);
    }

    .site-header__links a::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        inset-block-end: -2px;
        block-size: 2px;
        border-radius: 2px;
        background-color: var(--gold);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform var(--speed) var(--ease);
    }

    .site-header__links a:hover,
    .site-header__links a[aria-current='true'] {
        color: var(--on-navy);
    }

    .site-header__links a:hover::after,
    .site-header__links a[aria-current='true']::after {
        transform: scaleX(1);
    }

    .site-header__controls {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: 0 0 auto;
    }

    .lang-switch {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .lang-switch__link {
        padding: 0.3rem 0.4rem;
        border-radius: 4px;
        color: var(--on-navy-soft);
        transition:
            color var(--speed) var(--ease),
            background-color var(--speed) var(--ease);
    }

    .lang-switch__link:hover {
        background-color: var(--on-navy-hover);
        color: var(--on-navy);
    }

    .lang-switch__link[aria-current='true'] {
        color: var(--gold);
    }

    .lang-switch__divider {
        color: var(--on-navy-soft);
        opacity: 0.5;
    }

    .icon-button {
        display: grid;
        place-items: center;
        inline-size: 2.375rem;
        block-size: 2.375rem;
        border-radius: 8px;
        color: var(--on-navy-soft);
        transition:
            background-color var(--speed) var(--ease),
            color var(--speed) var(--ease);
    }

    .icon-button:hover {
        background-color: var(--on-navy-hover);
        color: var(--on-navy);
    }

    .icon-button__stack {
        display: grid;
        grid-template-areas: 'icon';
        place-items: center;
        inline-size: 1.25rem;
        block-size: 1.25rem;
        font-size: 1.25rem;
    }

    /* Both icons share one cell; the inactive one is faded and collapsed. */
    :global(.icon-button__icon) {
        grid-area: icon;
        transition:
            opacity var(--speed) var(--ease),
            transform var(--speed) var(--ease);
    }

    /* The icon mirrors the active mode: sun = dark, moon = light. */
    :global([data-theme-toggle] .icon-button__icon) {
        opacity: light-dark(0, 1);
        transform: rotate(-90deg) scale(0.5);
    }

    :global([data-theme-toggle] .icon-button__icon:first-child) {
        opacity: light-dark(1, 0);
        transform: none;
    }

    :global([data-theme-toggle] .icon-button__icon:last-child) {
        opacity: light-dark(0, 1);
        transform: rotate(90deg) scale(0.5);
    }

    .site-header__menu-button {
        display: none;
    }

    .site-header__menu-button :global(.icon-button__icon:last-child) {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
    }

    .site-header__menu-button[aria-expanded='true'] :global(.icon-button__icon:first-child) {
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
    }

    .site-header__menu-button[aria-expanded='true'] :global(.icon-button__icon:last-child) {
        opacity: 1;
        transform: none;
    }

    .mobile-nav {
        border-block-start: 1px solid var(--on-navy-line);
        background-color: var(--navy-900);
    }

    @media (width >= 60rem) {
        .mobile-nav {
            display: none;
        }
    }

    .mobile-nav__list {
        display: flex;
        flex-direction: column;
        list-style: none;
        margin: 0;
        padding-block: 0.5rem 1.25rem;
    }

    .mobile-nav__list a {
        display: block;
        padding-block: 0.75rem;
        border-block-start: 1px solid var(--on-navy-line);
        color: var(--on-navy-soft);
    }

    .mobile-nav__list a:hover,
    .mobile-nav__list a[aria-current='true'] {
        color: var(--gold);
    }

    @media (width < 60rem) {
        .site-header__nav {
            display: none;
        }

        .site-header__menu-button {
            display: grid;
        }
    }
</style>

<script>
    const STORAGE_KEY = 'bys-theme';
    const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

    if (themeToggle) {
        const root = document.documentElement;
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)');

        const isDark = () =>
            root.dataset.theme ? root.dataset.theme === 'dark' : systemPrefersDark.matches;

        const syncLabel = () => {
            const label = isDark() ? themeToggle.dataset.labelLight : themeToggle.dataset.labelDark;
            if (label) themeToggle.setAttribute('aria-label', label);
        };

        themeToggle.addEventListener('click', () => {
            const theme = isDark() ? 'light' : 'dark';
            root.dataset.theme = theme;
            try {
                localStorage.setItem(STORAGE_KEY, theme);
            } catch {}
            syncLabel();
        });

        systemPrefersDark.addEventListener('change', syncLabel);
        syncLabel();
    }

    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

    if (header && menuButton && mobileNav) {
        const closeMenu = () => {
            mobileNav.hidden = true;
            menuButton.setAttribute('aria-expanded', 'false');
        };

        menuButton.addEventListener('click', () => {
            const open = menuButton.getAttribute('aria-expanded') !== 'true';
            mobileNav.hidden = !open;
            menuButton.setAttribute('aria-expanded', String(open));
        });

        mobileNav.addEventListener('click', (event) => {
            if ((event.target as HTMLElement).closest('a')) closeMenu();
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
                closeMenu();
                menuButton.focus();
            }
        });
    }

    /* Scroll spy: highlights the section currently in view. */
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const sections = [...links]
        .map((link) => document.getElementById(link.dataset.navLink ?? ''))
        .filter((section): section is HTMLElement => section !== null);

    if (links.length > 0 && 'IntersectionObserver' in window) {
        const visible = new Set<string>();

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) visible.add(entry.target.id);
                    else visible.delete(entry.target.id);
                }

                const active = sections.find((section) => visible.has(section.id));
                if (!active) return;

                for (const link of links) {
                    const isActive = link.dataset.navLink === active.id;
                    if (isActive) link.setAttribute('aria-current', 'true');
                    else link.removeAttribute('aria-current');
                }
            },
            { rootMargin: '-45% 0px -50% 0px' },
        );

        for (const section of sections) observer.observe(section);
    }
</script>
