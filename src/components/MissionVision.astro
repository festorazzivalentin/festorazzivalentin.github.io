---
import type { Dictionary } from '@/i18n';

interface Props {
    t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section" id="mission" aria-labelledby="mission-heading">
    <div class="container">
        <h2 class="visually-hidden" id="mission-heading">{t.mission.title}</h2>
        <div class="mission-grid">
            <article class="mission-card">
                <h3 class="mission-card__title">{t.mission.missionLabel}</h3>
                <p>{t.mission.missionText}</p>
            </article>
            <article class="mission-card mission-card--vision">
                <h3 class="mission-card__title">{t.mission.visionLabel}</h3>
                <p>{t.mission.visionText}</p>
            </article>
        </div>
    </div>
</section>

<style>
    .mission-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        overflow: hidden;
        border: 1px solid var(--surface-border);
        border-radius: var(--radius);
        background-color: var(--surface-border);
    }

    .mission-card {
        --card-accent: var(--blue);

        padding: clamp(1.75rem, 4vw, 2.75rem);
        border-inline-start: 4px solid var(--card-accent);
        background-color: var(--surface);
    }

    .mission-card--vision {
        --card-accent: var(--gold);
    }

    .mission-card__title {
        font-size: var(--step-2);
        margin-block-end: 0.9rem;
    }

    .mission-card p {
        color: var(--text-secondary);
        font-size: var(--step-1);
        text-wrap: pretty;
    }

    @media (width < 47.5rem) {
        .mission-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
