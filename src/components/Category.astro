---
const { description, variant = 'wallet' } = Astro.props
---

<style>
  .education {
    --icon-color: #fdc312;
    --bg-color: #ffd861;
    --bg-color-light: #ffeeba;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(255, 215, 97, 0.48);
  }

  .credentialing {
    --bg-color: #b8f9d3;
    --bg-color-light: #e2fced;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(184, 249, 211, 0.48);
  }

  .wallet {
    --icon-color: #ac7afd;
    --bg-color: #ceb2fc;
    --bg-color-light: #f0e7ff;
    --text-color-hover: #fff;
    --box-shadow-color: rgba(206, 178, 252, 0.48);
  }

  .human-resources {
    --bg-color: #dce9ff;
    --bg-color-light: #f1f7ff;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(220, 233, 255, 0.48);
  }

/* Nuevas variantes */
  .pink {
    --icon-color: deeppink;
    --bg-color: #ffb3d1;
    --bg-color-light: #ffe0ec;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(255, 179, 209, 0.48);
  }

  .brown {
    --icon-color: #b38960;
    --bg-color: #d9b48f;
    --bg-color-light: #f0dcc4;
    --text-color-hover: #fff;
    --box-shadow-color: rgba(217, 180, 143, 0.48);
  }

  .seasonal-green {
    --bg-color: #8fd9a8;
    --bg-color-light: #d6f5e0;
    --text-color-hover: #fff;
    --box-shadow-color: rgba(143, 217, 168, 0.48);
  }

  .home-accents {
    --bg-color: #ffab91;
    --bg-color-light: #ffe0d6;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(255, 171, 145, 0.48);
  }

  .personal-care {
    --bg-color: #a0e7e5;
    --bg-color-light: #d9fbfa;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(160, 231, 229, 0.48);
  }

  .baby-kids {
    --bg-color: #b3e5fc;
    --bg-color-light: #e3f6ff;
    --text-color-hover: #4c5656;
    --box-shadow-color: rgba(179, 229, 252, 0.48);
  }

  .books {
    --bg-color: #f4a261;
    --bg-color-light: #fce3c7;
    --text-color-hover: #fff;
    --box-shadow-color: rgba(244, 162, 97, 0.48);
  }

  .card {
    width: 220px;
    height: 321px;
    background: #fff;
    border-top-right-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    box-shadow: 0 14px 26px rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease-out;
    text-decoration: none;
  }

  .card:hover {
    transform: translateY(-2px) scale(1.005) translateZ(0);
    box-shadow:
      0 24px 36px rgba(0, 0, 0, 0.11),
      0 24px 46px var(--box-shadow-color);
  }

  .card:hover .overlay {
    transform: scale(4) translateZ(0);
  }

  .card:hover .circle {
    border-color: var(--bg-color-light);
    background: var(--bg-color);
  }

  .card:hover :global(svg) {
    color: var(--icon-color);
    transition: color .6s;
  }

  .card:hover .circle:after {
    background: var(--bg-color-light);
  }

  .card:hover p {
    color: var(--text-color-hover);
  }

  .card:active {
    transform: scale(1) translateZ(0);
    box-shadow:
      0 15px 24px rgba(0, 0, 0, 0.11),
      0 15px 24px var(--box-shadow-color);
  }

  .card p {
    font-size: 17px;
    color: #4c5656;
    margin-top: 30px;
    z-index: 1000;
    transition: color 0.3s ease-out;
  }

  .circle {
    width: 136px;
    height: 136px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--bg-color);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 1;
    transition: all 0.3s ease-out;
  }

  .circle:after {
    content: "";
    width: 118px;
    height: 118px;
    display: block;
    position: absolute;
    background: var(--bg-color);
    border-radius: 50%;
    top: 7px;
    left: 7px;
    z-index: -2;
    transition: opacity 0.3s ease-out;
  }

  .circle :global(svg) {
    z-index: 0;
    width: 90px;
    color: var(--bg-color-light);
    transform: translateZ(0);
  }


  .overlay {
    width: 118px;
    position: absolute;
    height: 118px;
    border-radius: 50%;
    background: var(--bg-color);
    top: 70px;
    left: 50px;
    z-index: 0;
    transition: transform 0.3s ease-out;
  }
</style>

<div class:list={["card", variant]}>
  <div class="overlay"></div>
  <div class="circle">
    <slot class="icon" name="svg" />
  </div>
  <p>{description}</p>
</div>