---
import Icon from '@/components/Icon.astro';
import { SERVICE_ICONS } from '@/data/site';
import type { Dictionary } from '@/i18n';

interface Props {
    t: Dictionary;
}

const { t } = Astro.props;
---

<section class="section section--alt" id="services">
    <div class="container">
        <div class="section-head">
            <h2>{t.services.title}</h2>
            <p>{t.services.subtitle}</p>
        </div>

        <div class="services">
            {
                t.services.items.map((service, index) => (
                    <article class="service">
                        <span class="service__icon">
                            <Icon name={SERVICE_ICONS[index % SERVICE_ICONS.length]} />
                        </span>
                        <div>
                            <h3 class="service__title">{service.title}</h3>
                            <p class="service__desc">{service.desc}</p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services {
        display: flex;
        flex-direction: column;
    }

    .service {
        display: flex;
        gap: clamp(1.25rem, 4vw, 3rem);
        align-items: flex-start;
        padding-block: clamp(1.75rem, 3vw, 2.25rem);
        border-block-start: 1px solid var(--surface-border);
    }

    .service:last-child {
        border-block-end: 1px solid var(--surface-border);
    }

    .service:nth-child(even) {
        flex-direction: row-reverse;
        text-align: end;
    }

    .service__icon {
        display: grid;
        place-items: center;
        inline-size: 3.25rem;
        block-size: 3.25rem;
        flex: 0 0 auto;
        border-radius: var(--radius);
        background-color: var(--accent-soft);
        color: var(--accent-icon);
        font-size: 1.6rem;
    }

    .service:nth-child(even) .service__icon {
        background-color: color-mix(in srgb, var(--gold) 14%, transparent);
        color: var(--gold-text);
    }

    .service__title {
        font-size: var(--step-2);
        font-weight: 600;
        margin-block-end: 0.4rem;
    }

    .service__desc {
        max-inline-size: 56ch;
        color: var(--text-secondary);
        text-wrap: pretty;
    }

    .service:nth-child(even) .service__desc {
        margin-inline-start: auto;
    }

    @media (width < 40rem) {
        .service,
        .service:nth-child(even) {
            flex-direction: column;
            gap: 0.9rem;
            text-align: start;
        }

        .service:nth-child(even) .service__desc {
            margin-inline-start: 0;
        }
    }
</style>
