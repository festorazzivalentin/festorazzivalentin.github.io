---
/**
 * Inline stroke icon registry (24x24, inherits `currentColor`).
 * Filled / sprite icons live in their own components.
 */
interface Props {
    name: string;
    class?: string;
}

const { name, class: className } = Astro.props;

const ICONS: Record<string, string> = {
    sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/>',
    moon: '<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
    menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
    close: '<path d="M5 5l14 14M19 5L5 19"/>',
    import: '<path d="M12 3v10"/><path d="M7.5 9.5 12 14l4.5-4.5"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>',
    export: '<path d="M12 14V4"/><path d="M7.5 7.5 12 3l4.5 4.5"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>',
    distribution:
        '<circle cx="12" cy="12" r="2.1"/><circle cx="4.2" cy="5" r="1.7"/><circle cx="19.8" cy="5" r="1.7"/><circle cx="4.2" cy="19" r="1.7"/><circle cx="19.8" cy="19" r="1.7"/><path d="M10.4 10.4 5.6 6.3"/><path d="M13.6 10.4 18.4 6.3"/><path d="M10.4 13.6 5.6 17.7"/><path d="M13.6 13.6 18.4 17.7"/>',
    warehouse:
        '<path d="M3 10 12 4l9 6"/><path d="M5 9v11h14V9"/><path d="M10 20v-6h4v6"/>',
    globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><ellipse cx="12" cy="12" rx="4" ry="8.5"/>',
    chart: '<path d="M5 20V15"/><path d="M12 20V10"/><path d="M19 20V5"/>',
    reach: '<circle cx="12" cy="12" r="2"/><circle cx="12" cy="12" r="6" opacity="0.6"/><circle cx="12" cy="12" r="10" opacity="0.3"/>',
    shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
    people:
        '<circle cx="9" cy="8" r="3"/><path d="M3.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6"/><circle cx="17.5" cy="7" r="2.2"/><path d="M14.8 13.2c2.6.4 4.2 2.6 4.2 5.8"/>',
    grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.2"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.2"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.2"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.2"/>',
    pin: '<path d="M20 10c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2.6"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2.2"/><path d="m4 7 8 6 8-6"/>',
    clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
    arrowRight: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
};

const shapes = ICONS[name];
---

{
    shapes && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            set:html={shapes}
        />
    )
}

<style>
    /* Sized from the inherited font-size, so parents control it with `font-size`. */
    svg {
        inline-size: 1em;
        block-size: 1em;
        flex: 0 0 auto;
    }
</style>
