---
import Tilt from '@/components/Tilt.astro';
import Verification from '@/components/Verification.astro';
import LogoBlueYellow from '@/components/LogoBlueYellow.astro';
import LinkBtn from '@/components/LinkBtn.astro';
import FlagList from '@/components/FlagList.astro';
import ContactBtn from '@/components/ContactBtn.astro';
import InputLabel from '@/components/InputLabel.astro';


const title = 'Blue and Yellow';
const description = 'Compañia de exportación e importación'
---

<!DOCTYPE html>
<html lang="en">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name"description" content={description}>
    <title>{title}</title>
    <link rel="stylesheet" href="/index.css">
<body>
    <Verification />
    <LogoBlueYellow />
    <LinkBtn value="Nosotros" />
    <LinkBtn value="Contacto" />
    <LinkBtn value="Intereses" />
    <FlagList />
    <Tilt />
    <hr>
    <ContactBtn value="Contáctanos" />
    <hr>
    <InputLabel text="Correo electrónico" type="email" placeholder="distribuidor@gmail.com" />
</body>
</html>