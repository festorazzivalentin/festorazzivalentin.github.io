---
import Head from '@/layouts/Head.astro';
import Presentation from '@/layouts/Presentation.astro';
import '../index.css';
import Verifications from '@/layouts/Verifications.astro';
import Flags from '@/layouts/Flags.astro';
import Categories from '@/layouts/Categories.astro';
import Form from '@/layouts/Form.astro';
import Footer from '@/layouts/Footer.astro';
import Socios from '@/layouts/Socios.astro';

const title = 'Blue and Yellow';
const description = 'Compañia de exportación e importación'
---

<!DOCTYPE html>
<html lang="en">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name"description" content={description}>
    <title>{title}</title>
    <link rel="icon" href="/assets/favicon.ico">
<body>
    <Head />
    <Presentation />
    <Verifications />
    <Categories/>
    <Socios/>
    <!-- <Flags /> -->
    <Form />
    <Footer />
</body>
</html>